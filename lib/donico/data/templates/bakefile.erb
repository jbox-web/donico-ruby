# Instead edit donico.yml and run bin/rake generate-files

<%- images.each do |image| %>
<%- comments = (image.distro.size + image.name.size + image.version.size + 8).times.map { "#" }.join('') -%>
<%= comments %>
# <%= image.distro.upcase %> - <%= image.name %> <%= image.version %> #
<%= comments %>

<%- image.build_args.each do |arg| -%>
<%- name, value = arg.split('=', 2) -%>
variable "<%= name %>" {
  validation {
    condition = <%= name %> != ""
    error_message = "The variable '<%= name %>' must not be empty."
  }
}

<%- end -%>
target "<%= image.distro %>-<%= image.version.gsub('.', '-') %>-build" {
  dockerfile = "<%= image.dockerfile %>"
  args = {
    <%- image.build_args.each do |arg| -%>
    <%- name, value = arg.split('=', 2) -%>
    <%- if name == "BUILD_DATE" -%>
    <%= name %> = "${<%= name %>}"
    <%- else -%>
    <%= name %> = "<%= value %>"
    <%- end -%>
    <%- end -%>
  }
  tags      = ["<%= image.name %>/${<%= image.version_env_var %>}/${DISTRO_NAME}:${BUILD_DATE}"]
  platforms = <%= image.archs %>
  output    = [{ type = "docker" }]
}

target "<%= image.distro %>-<%= image.version.gsub('.', '-') %>-push" {
  dockerfile = "<%= image.dockerfile %>"
  args = {
    <%- image.build_args.each do |arg| -%>
    <%- name, value = arg.split('=', 2) -%>
    <%- if name == "BUILD_DATE" -%>
    <%= name %> = "${<%= name %>}"
    <%- else -%>
    <%= name %> = "<%= value %>"
    <%- end -%>
    <%- end -%>
  }
  tags      = <%= image.prod_tags %>
  platforms = <%= image.archs %>
  output    = [{ type = "registry" }]
}
<%- end -%>
