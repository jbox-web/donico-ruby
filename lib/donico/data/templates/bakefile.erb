variable "BUILD_DATE" {
  validation {
    condition = BUILD_DATE != ""
    error_message = "The variable 'BUILD_DATE' must not be empty."
  }
}
<%- images.each do |image| %>
<%- comments = (image.distro.size + image.name.size + image.version.size + 8).times.map { "#" }.join('') -%>
<%= comments %>
# <%= image.distro.upcase %> - <%= image.name %> <%= image.version %> #
<%= comments %>

target "<%= image.distro %>-<%= image.version.gsub('.', '-') %>-build" {
  dockerfile = "<%= image.dockerfile %>"
  args = {
    <%- image.build_args.each do |arg| -%>
    <%- name, value = arg.split('=', 2) -%>
    <%- if name == "BUILD_DATE" -%>
    <%= name %> = "${<%= name %>}"
    <%- else -%>
    <%= name %> = "<%= Donico::Templates::Hcl.escape(value) %>"
    <%- end -%>
    <%- end -%>
  }
  <%- if image.secrets? -%>
  secret = [
    <%- image.secret_envs.each do |secret| -%>
    {
      type = "env"
      id = "<%= Donico::Templates::Hcl.escape(secret["id"]) %>"
    },
    <%- end -%>
    <%- image.secret_files.each do |secret| -%>
    {
      type = "file"
      id = "<%= Donico::Templates::Hcl.escape(secret["id"]) %>"
      src = "<%= Donico::Templates::Hcl.escape(secret["src"]) %>"
    },
    <%- end -%>
  ]
  <%- end -%>
  platforms = <%= image.archs %>
  output    = [{ type = "docker" }]
  tags      = ["<%= image.name %>/<%= image.version %>/<%= image.distro %>:${BUILD_DATE}"]
}

target "<%= image.distro %>-<%= image.version.gsub('.', '-') %>-push" {
  dockerfile = "<%= image.dockerfile %>"
  args = {
    <%- image.build_args.each do |arg| -%>
    <%- name, value = arg.split('=', 2) -%>
    <%- if name == "BUILD_DATE" -%>
    <%= name %> = "${<%= name %>}"
    <%- else -%>
    <%= name %> = "<%= Donico::Templates::Hcl.escape(value) %>"
    <%- end -%>
    <%- end -%>
  }
  <%- if image.secrets? -%>
  secret = [
    <%- image.secret_envs.each do |secret| -%>
    {
      type = "env"
      id = "<%= Donico::Templates::Hcl.escape(secret["id"]) %>"
    },
    <%- end -%>
    <%- image.secret_files.each do |secret| -%>
    {
      type = "file"
      id = "<%= Donico::Templates::Hcl.escape(secret["id"]) %>"
      src = "<%= Donico::Templates::Hcl.escape(secret["src"]) %>"
    },
    <%- end -%>
  ]
  <%- end -%>
  platforms = <%= image.archs %>
  output    = [{ type = "registry" }]
  tags      = [
  <%- image.prod_tags.each do |tag| -%>
    "<%= tag %>",
  <%- end -%>
  ]
}
<%- end -%>
